    <!-- Cleanup confirm sheet -->
    <string name="cleanup_sheet_title">சுத்தம் செய்</string>
    <string name="cleanup_sheet_message">குப்பையிலுள்ள %1$s உருப்படிகளையும் %2$s கேஷையும் அழிக்கவா?</string>
    <string name="cleanup_sheet_detail">இந்த உருப்படிகள் ஏற்கனவே Android குப்பையில் உள்ளன; உங்கள் கேலரியில் உள்ள படங்கள் அல்ல. Android இன்னொரு முறை உறுதிப்படுத்தக் கேட்கும், அவற்றை “படங்கள்” என்றும் குறிப்பிடலாம். வேறு எதுவும் தொடப்படாது.</string>
    <string name="cleanup_result_freed">விடுவிக்கப்பட்டது</string>

    <!-- Media access disclosure -->
    <string name="media_disclosure_title">மீடியா அணுகலை அனுமதிக்கவும்</string>
    <string name="media_disclosure_body">பெரிய கோப்புகள், நகல்கள் மற்றும் ஒத்த படங்களைக் கண்டறிய, இந்த ஆப்புக்கு உங்கள் படங்கள், வீடியோக்கள் மற்றும் ஆடியோவுக்கான அணுகல் தேவை. கோப்புகள் உங்கள் சாதனத்திலேயே பகுப்பாய்வு செய்யப்படும்; ஒருபோதும் பதிவேற்றப்படாது.</string>

