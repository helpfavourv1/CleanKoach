    <!-- Settings — About -->
    <string name="about_title">பற்றி</string>
    <string name="about_body">Android-க்கான சேமிப்பக சுத்தம் ஆப். அனைத்தும் சாதனத்திலேயே நடக்கும். மீடியா, பயன்பாட்டுத் தரவு, ஸ்கேன் முடிவுகள் எதுவும் ஒருபோதும் பதிவேற்றப்படாது.</string>
    <string name="about_built_with">Kotlin, Jetpack Compose, Material 3 கொண்டு உருவாக்கப்பட்டது.</string>

